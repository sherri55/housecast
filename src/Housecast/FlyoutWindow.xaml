<Window x:Class="Housecast.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Housecast"
        Title="Housecast"
        Width="400"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <!-- Colour brushes (Text, SubtleText, Accent, Surface, Divider, ButtonBackground, ButtonBorder, Track, Card) are set by ApplyTheme -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <!-- The two halves of a slider track either side of the thumb -->
        <Style x:Key="TrackPart" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A slim track filled with the accent colour up to a round thumb, like Windows 11 and iOS -->
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackPart}" Background="{DynamicResource Accent}" Command="Slider.DecreaseLarge" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource TrackPart}" Background="{DynamicResource Track}" Command="Slider.IncreaseLarge" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="White" Stroke="{DynamicResource ButtonBorder}" StrokeThickness="1">
                                                <Ellipse.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" />
                                                </Ellipse.Effect>
                                            </Ellipse>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Box" CornerRadius="6" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- A group's icon: white on an accent-coloured circle, so groups stand apart from speakers -->
        <Style x:Key="GroupBadge" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <!-- The group badge with its icon: two speakers, one behind the other -->
        <Style x:Key="GroupBadgeIcon" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Style="{StaticResource GroupBadge}">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static local:DeviceModels.SpeakerIcon}" FontFamily="Segoe Fluent Icons" FontSize="12"
                                           Foreground="{DynamicResource Surface}" Opacity="0.6" Margin="0,0,5,5" />
                                <TextBlock Text="{x:Static local:DeviceModels.SpeakerIcon}" FontFamily="Segoe Fluent Icons" FontSize="12"
                                           Foreground="{DynamicResource Surface}" Margin="5,5,0,0" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- One of a group's speakers on its card: filled while it plays, outlined when it doesn't -->
        <Style x:Key="MemberPill" TargetType="Border">
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="8,3,10,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Accent}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MemberPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Surface}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- A full-width dashed row for adding something, like the end of an iOS list -->
        <Style x:Key="AddRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Rectangle x:Name="Outline" RadiusX="10" RadiusY="10" Stroke="{DynamicResource ButtonBorder}"
                                       StrokeThickness="1" StrokeDashArray="4 3" />
                            <ContentPresenter Margin="12,10" HorizontalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outline" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Behind a speaker or group row: turns into a card around its controls when selected -->
        <Style x:Key="SelectableCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="-8,0,-8,4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Card}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- Small icon at the start of a control row -->
        <Style x:Key="ControlIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        </Style>
        <!-- A whole-row toggle like the iPhone AirPlay list: content on the left, a round check on the right -->
        <Style x:Key="DeviceRow" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Row" CornerRadius="6" Padding="8,6" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Width="20" Height="20" VerticalAlignment="Center">
                                    <Ellipse x:Name="Circle" Stroke="{DynamicResource ButtonBorder}" StrokeThickness="1.5" />
                                    <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="11"
                                               Foreground="{DynamicResource Surface}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource ButtonBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DeviceIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <!-- − and + beside a slider; they use the slider's own SmallChange step -->
        <Style x:Key="StepButton" TargetType="RepeatButton">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="60" />
            <!-- The standard button template ignores Background, which breaks dark mode -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Chrome" CornerRadius="12" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Divider}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatButton" TargetType="Button">
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" CornerRadius="14" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource Divider}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The main action in a form; give it plain text content so it takes this foreground -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="{DynamicResource Surface}" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Foreground" Value="#E0605A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <!-- A small round button holding one Segoe Fluent Icons glyph -->
        <Style x:Key="RoundIconButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </Window.Resources>

    <Border x:Name="Root" Margin="12" Padding="8,16,8,12" CornerRadius="8" Background="{DynamicResource Surface}"
            BorderBrush="{DynamicResource Divider}" BorderThickness="1">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootOffset" />
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>

        <DockPanel>
            <!-- Header: what's playing, and the volume for all of it, always in reach above the list -->
            <StackPanel DockPanel.Dock="Top" Margin="8,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <!-- The Housecast mark, drawn like the tray icon: a house with sound waves rising inside it -->
                    <Border Width="36" Height="36" CornerRadius="9" Background="{DynamicResource Accent}" Margin="0,0,12,0">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="32" Height="32">
                                <Path Data="M5,15 L16,5 L27,15 M8,12.5 V27 H24 V12.5" Stroke="{DynamicResource Surface}" StrokeThickness="2.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Path Data="M12.8,20.8 A4.5,4.5 0 0 1 19.2,20.8 M10.3,18.3 A8,8 0 0 1 21.7,18.3" Stroke="{DynamicResource Surface}"
                                      StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="14.2" Canvas.Top="22.2" Width="3.6" Height="3.6" Fill="{DynamicResource Surface}" />
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Housecast" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NowPlaying}" FontSize="12" Foreground="{DynamicResource SubtleText}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="300" />
                    </StackPanel>
                </StackPanel>

                <Grid Margin="0,14,0,0" ToolTip="Volume of every AirPlay speaker at once">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="48" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource ControlIcon}" Text="&#xE767;" FontSize="16" Foreground="{DynamicResource Text}" />
                    <RepeatButton Grid.Column="1" Content="&#xE949;" Style="{StaticResource StepButton}"
                                  Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=MasterSlider}" />
                    <Slider x:Name="MasterSlider" Grid.Column="2" Minimum="0" Maximum="100" SmallChange="1"
                            Value="{Binding MasterVolume, Delay=250}" />
                    <RepeatButton Grid.Column="3" Content="&#xE948;" Style="{StaticResource StepButton}"
                                  Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=MasterSlider}" />
                    <TextBlock Grid.Column="4" Text="{Binding MasterVolume, StringFormat={}{0}%}" FontSize="12"
                               Foreground="{DynamicResource SubtleText}" TextAlignment="Right" VerticalAlignment="Center" />
                </Grid>

                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,12,0,4" />
            </StackPanel>

            <!-- Scrolls once open cards make the flyout taller than the screen; the side margin
                 leaves room for the cards' negative margins, which the scroll area would clip -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="8,0">
                    <CheckBox Style="{StaticResource DeviceRow}" IsChecked="{Binding PlayOnThisPc}" Margin="-8,4,-8,0"
                              ToolTip="Untick to mute this PC's own speakers while AirPlay plays">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DeviceIcon}" Text="{x:Static local:DeviceModels.ComputerIcon}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="This PC" />
                                <TextBlock Text="Speakers on this computer" FontSize="11" Foreground="{DynamicResource SubtleText}" />
                            </StackPanel>
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SubtleText}" Margin="0,8"
                               Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />

                    <TextBlock Text="Groups" Style="{StaticResource SectionLabel}"
                               Visibility="{Binding HasGroups, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource SelectableCard}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Edit group" Click="EditGroupButton_Click" />
                                            <MenuItem Header="Delete group" Click="DeleteGroupMenu_Click" />
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource DeviceRow}" IsChecked="{Binding IsSelected}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Orientation="Horizontal">
                                                    <ContentControl Style="{StaticResource GroupBadgeIcon}" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SubtleText}"
                                                                   TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- A button inside the row handles its own click, so it doesn't tick the group -->
                                                <Button Grid.Column="1" Content="&#xE70F;" Style="{StaticResource RoundIconButton}"
                                                        Margin="6,0,10,0" Click="EditGroupButton_Click" ToolTip="Edit or delete this group" />
                                            </Grid>
                                        </CheckBox>

                                        <StackPanel Margin="12,2,12,12" Visibility="{Binding IsSelected, Converter={StaticResource Visible}}">
                                            <!-- The group's speakers as pills -->
                                            <Grid Margin="0,0,0,6">
                                                <ItemsControl ItemsSource="{Binding Members}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource MemberPill}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Style="{StaticResource MemberPillText}" Text="{Binding Icon}"
                                                                               FontFamily="Segoe Fluent Icons" Margin="0,0,5,0" />
                                                                    <TextBlock Style="{StaticResource MemberPillText}" Text="{Binding Name}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <Grid Visibility="{Binding HasVolume, Converter={StaticResource Visible}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="64" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource ControlIcon}" Text="&#xE995;" ToolTip="Volume of every speaker in the group" />
                                                <RepeatButton Grid.Column="1" Content="&#xE949;" Style="{StaticResource StepButton}"
                                                              Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=GroupVolumeSlider}" />
                                                <Slider x:Name="GroupVolumeSlider" Grid.Column="2" Minimum="0" Maximum="100" SmallChange="1"
                                                        Value="{Binding Volume, Delay=250}" />
                                                <RepeatButton Grid.Column="3" Content="&#xE948;" Style="{StaticResource StepButton}"
                                                              Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=GroupVolumeSlider}" />
                                                <TextBlock Grid.Column="4" Text="{Binding Volume, StringFormat={}{0}%}" FontSize="12"
                                                           Foreground="{DynamicResource SubtleText}" TextAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Speakers" Style="{StaticResource SectionLabel}" />
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- A selected speaker becomes a card holding its row and its controls -->
                                <Border Style="{StaticResource SelectableCard}">
                                    <StackPanel>
                                        <CheckBox Style="{StaticResource DeviceRow}" IsChecked="{Binding IsSelected}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource DeviceIcon}" Text="{Binding Icon}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SubtleText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </CheckBox>

                                        <Grid Margin="12,2,12,12" Visibility="{Binding IsSelected, Converter={StaticResource Visible}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="64" />
                                            </Grid.ColumnDefinitions>
                                            <!-- The volume row shows once the speaker plays and has said what its volume is -->
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Style="{StaticResource ControlIcon}" Text="&#xE995;" ToolTip="Volume" Visibility="{Binding HasVolume, Converter={StaticResource Visible}}" />
                                            <RepeatButton Grid.Column="1" Content="&#xE949;" Style="{StaticResource StepButton}" Visibility="{Binding HasVolume, Converter={StaticResource Visible}}"
                                                          Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=VolumeSlider}" />
                                            <Slider x:Name="VolumeSlider" Grid.Column="2" Minimum="0" Maximum="100" SmallChange="1" Visibility="{Binding HasVolume, Converter={StaticResource Visible}}"
                                                    Value="{Binding Volume, Delay=250}" />
                                            <RepeatButton Grid.Column="3" Content="&#xE948;" Style="{StaticResource StepButton}" Visibility="{Binding HasVolume, Converter={StaticResource Visible}}"
                                                          Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=VolumeSlider}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Volume, StringFormat={}{0}%}" FontSize="12" Visibility="{Binding HasVolume, Converter={StaticResource Visible}}"
                                                       Foreground="{DynamicResource SubtleText}" TextAlignment="Right" VerticalAlignment="Center" />

                                            <TextBlock Grid.Row="1" Style="{StaticResource ControlIcon}" Text="&#xE916;"
                                                       ToolTip="Delay: shift this speaker earlier or later to line it up with the others" />
                                            <RepeatButton Grid.Row="1" Grid.Column="1" Content="&#xE949;" Style="{StaticResource StepButton}"
                                                          Command="Slider.DecreaseSmall" CommandTarget="{Binding ElementName=DelaySlider}" />
                                            <Slider x:Name="DelaySlider" Grid.Row="1" Grid.Column="2" Minimum="-2000" Maximum="2000"
                                                    SmallChange="100" TickFrequency="10" IsSnapToTickEnabled="True"
                                                    Value="{Binding OffsetMs, Delay=400}" />
                                            <RepeatButton Grid.Row="1" Grid.Column="3" Content="&#xE948;" Style="{StaticResource StepButton}"
                                                          Command="Slider.IncreaseSmall" CommandTarget="{Binding ElementName=DelaySlider}" />
                                            <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding OffsetMs, StringFormat={}{0} ms}" FontSize="12"
                                                       Foreground="{DynamicResource SubtleText}" TextAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Margin="12,0,12,12" Visibility="{Binding NeedsPin, Converter={StaticResource Visible}}">
                                            <TextBlock Text="Enter the PIN shown on the device" Foreground="{DynamicResource SubtleText}" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBox Text="{Binding Pin, UpdateSourceTrigger=PropertyChanged}" Width="80" MaxLength="8"
                                                         Padding="4,2" KeyDown="PinBox_KeyDown" />
                                                <Button Content="Pair" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="PairButton_Click" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Style="{StaticResource AddRow}" Margin="0,6,0,4" Click="NewGroupButton_Click"
                            Visibility="{Binding IsNotEditingGroup, Converter={StaticResource Visible}}"
                            ToolTip="Make a group of speakers you can tick in one go">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="New group" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </StackPanel>
                    </Button>

                    <!-- Group editor: a name and the speakers in it -->
                    <Border CornerRadius="10" Padding="14" Margin="-8,6,-8,4" Background="{DynamicResource Card}"
                            Visibility="{Binding IsEditingGroup, Converter={StaticResource Visible}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ContentControl Style="{StaticResource GroupBadgeIcon}" />
                                <TextBlock Text="{Binding GroupEditorTitle}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="Name" FontSize="11" Foreground="{DynamicResource SubtleText}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding GroupName, UpdateSourceTrigger=PropertyChanged}" MaxLength="40" />

                            <TextBlock Text="Speakers" FontSize="11" Foreground="{DynamicResource SubtleText}" Margin="0,12,0,2" />
                            <ItemsControl ItemsSource="{Binding GroupChoices}" Margin="-8,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Style="{StaticResource DeviceRow}" IsChecked="{Binding IsChosen}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource DeviceIcon}" Text="{Binding Icon}" FontSize="16" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource SubtleText}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding GroupError}" Foreground="#E0605A" TextWrapping="Wrap" Margin="0,6,0,0" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource DangerButton}" Padding="6,5" Click="DeleteGroupButton_Click"
                                        Visibility="{Binding CanDeleteGroup, Converter={StaticResource Visible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="Delete" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Content="Cancel" Style="{StaticResource FlatButton}" Margin="0,0,8,0" Click="CancelGroupButton_Click" />
                                <Button Grid.Column="3" Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="72" Click="SaveGroupButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
